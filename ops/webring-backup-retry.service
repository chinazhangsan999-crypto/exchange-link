[Unit]
Description=Retry incomplete Telegram database backup uploads
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=niaiwo
Group=niaiwo
WorkingDirectory=/opt/webring/app
EnvironmentFile=-/opt/webring/secrets/webring.env
ExecStart=/usr/bin/node /opt/webring/app/scripts/retry-telegram-backups.js
