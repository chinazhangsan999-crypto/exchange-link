link.chinazhangsan.ccwu.cc, origin-link.chinazhangsan.ccwu.cc {
    header {
        Strict-Transport-Security "max-age=31536000"
    }

    # 仅 Cloudflare 官方边缘网段的请求才可使用 CF-Connecting-IP。
    # 该片段由 systemd 定时任务核验、原子更新，并在 Caddy 校验成功后重载。
    import cloudflare-ips.caddy
    handle @cloudflare {
        reverse_proxy 127.0.0.1:3001 {
            # 丢弃公网请求自带的转发身份，只使用 Cloudflare 注入的客户端地址。
            header_up -Forwarded
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }

    handle {
        # 源站直连不再进入 Node，避免绕过 Cloudflare 的 WAF 与真实 IP 链路。
        respond "Not Found" 404
    }
}

ip.chinazhangsan.ccwu.cc {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3101
}
