name = "webring-public-production"
main = "worker.js"
compatibility_date = "2026-09-14"

routes = [
  { pattern = "qiantai.chinazhangsan.ccwu.cc", custom_domain = true }
]

[assets]
directory = "../../dist/public-frontend"
binding = "ASSETS"
run_worker_first = ["/", "/index.html", "/r/*", "/api/*", "/go", "/favicon.ico", "/.well-known/route-health.gif", "/uploads/logo/*"]

[vars]
API_ORIGIN = "https://api-link.chinazhangsan.ccwu.cc"

# 通过 `wrangler secret put FRONTEND_PROXY_SECRET` 注入，绝不能写入本文件。
