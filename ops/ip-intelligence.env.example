# 中心 IP 情报服务。每个导航站必须使用独立客户端密钥。
IP_INTELLIGENCE_ENABLED=1
IP_INTELLIGENCE_BASE_URL=https://ip.chinazhangsan.ccwu.cc
IP_INTELLIGENCE_CLIENT_ID=nav-main
IP_INTELLIGENCE_CLIENT_SECRET=请在服务器私有环境文件中填写

# PM2 部署也可改用权限为 600 的 JSON 凭据文件，此时无需把密钥写进 PM2 环境：
# IP_INTELLIGENCE_CREDENTIAL_FILE=/home/niaiwo/.config/webring/nav-main-client.json

# 查询在后台执行，不阻塞访客请求。单批最多 100 个 IP。
IP_INTELLIGENCE_TIMEOUT_MS=3000
IP_INTELLIGENCE_BATCH_SIZE=50
