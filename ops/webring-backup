#!/usr/bin/env bash
set -euo pipefail

APP_DIR=${APP_DIR:-/opt/webring/app}
ENV_FILE=${ENV_FILE:-/opt/webring/secrets/webring.env}
if [[ -f "$ENV_FILE" ]]; then
  set -a
  . "$ENV_FILE"
  set +a
fi
DATABASE_PATH=${DB_PATH:-$APP_DIR/webring.db}
BACKUP_DIR=${TELEGRAM_BACKUP_DIRECTORY:-$APP_DIR/backups/webring}
STAMP=$(TZ=Asia/Shanghai date '+%Y%m%d-%H%M%S')
TEMP_FILE="$BACKUP_DIR/.webring-$STAMP.db.tmp"
FINAL_FILE="$BACKUP_DIR/webring-$STAMP.db"

notify_failure() {
  rm -f "$TEMP_FILE"
  if [[ -f "$ENV_FILE" ]]; then
    node "$APP_DIR/scripts/send-ops-alert.js" '🔴 SQLite 备份失败' "备份时间：$(TZ=Asia/Shanghai date '+%F %T')" || true
  fi
}
trap notify_failure ERR

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"
node "$APP_DIR/scripts/backup-sqlite.js" "$DATABASE_PATH" "$TEMP_FILE" >/dev/null
node - "$TEMP_FILE" "$APP_DIR" <<'NODE'
const [file, app] = process.argv.slice(2);
const sqlite3 = require(`${app}/node_modules/sqlite3`).verbose();
const db = new sqlite3.Database(file, sqlite3.OPEN_READONLY);
db.get('PRAGMA integrity_check', (error, row) => {
  db.close();
  if (error || row?.integrity_check !== 'ok') {
    console.error(error?.message || 'SQLite integrity_check 未通过');
    process.exitCode = 1;
  }
});
NODE
mv "$TEMP_FILE" "$FINAL_FILE"
sha256sum "$FINAL_FILE" > "$FINAL_FILE.sha256"
node "$APP_DIR/scripts/send-telegram-backup.js" "$FINAL_FILE"
find "$BACKUP_DIR" -maxdepth 1 -type f \( \
  -name 'webring-*.db' -o -name 'webring-*.db.sha256' -o \
  -name 'webring-*.db.gz.aes' -o -name 'webring-*.db.gz.aes.part*' -o \
  -name 'webring-*.manifest.json' \
\) -mtime +14 -delete
trap - ERR
