{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webring.local/protocol/v1/config-snapshot.schema.json",
  "title": "站点配置完整快照",
  "type": "object",
  "required": ["protocol_version", "site_id", "revision", "revisions", "nodes", "ads", "ad_policies", "publish"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "site_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "string", "pattern": "^[0-9]+-[0-9]+-[0-9]+$" },
    "revisions": {
      "type": "object",
      "required": ["nodes_revision", "ads_revision", "publish_revision"],
      "properties": {
        "nodes_revision": { "$ref": "#/$defs/revisionPart" },
        "ads_revision": { "$ref": "#/$defs/revisionPart" },
        "publish_revision": { "$ref": "#/$defs/revisionPart" }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "ads": { "type": "array", "items": { "$ref": "#/$defs/ad" } },
    "ad_policies": { "type": "array", "items": { "$ref": "#/$defs/adPolicy" } },
    "publish": {
      "type": "object",
      "required": ["permanent_url", "github_pages_url"],
      "properties": {
        "permanent_url": { "type": "string" },
        "github_pages_url": { "type": "string" }
      }
    }
  },
  "$defs": {
    "id": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    },
    "revisionPart": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+$" }
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "speed_name", "partner_name", "url", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "speed_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "partner_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri" },
        "enabled": { "type": "boolean" },
        "sort_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
      }
    },
    "ad": {
      "type": "object",
      "required": ["id", "namespace", "title", "ad_type", "ad_position", "platform", "ad_code", "image_url", "target_url", "integrity_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ad_type": { "enum": ["normal", "code"] },
        "ad_position": { "enum": ["banner", "icon", "top_float", "bottom_float", "icon_float"] },
        "platform": { "enum": ["all", "pc", "ios", "non_ios", "android", "harmony"] },
        "ad_code": { "type": "string" },
        "image_url": { "type": "string" },
        "target_url": { "type": "string" },
        "priority": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "integrity_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "adPolicy": {
      "type": "object",
      "required": ["slot", "policy"],
      "properties": {
        "slot": { "enum": ["banner", "icon", "top_float", "bottom_float", "icon_float"] },
        "policy": { "enum": ["central_only", "central_first", "mixed", "local_only"] }
      }
    }
  }
}
